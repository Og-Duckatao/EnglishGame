        words.add("IRONY");
        words.add("VERBAL IRONY");
        words.add("SITUATIONAL IRONY");
        words.add("DRAMATIC IRONY");
        words.add("JUXTAPOSITION");
        words.add("LITOTES");
        words.add("LOCAL COLOR");
        words.add("LOOSE SENTENCE");
        words.add("LYRIC POEM");
        words.add("METAPHOR");
        words.add("IMPLIED METAPHOR");
        words.add("EXTENDED METAPHOR");
        words.add("DEAD METAPHOR");
        words.add("MIXED METAPHOR");
        words.add("METONYMY");
        words.add("MOOD");
        words.add("MOTIF");
        words.add("MOTIVATION");
        words.add("ONOMATOPOEIA");
        words.add("OXYMORON");
        words.add("PARABLE");
        words.add("PARADOX");
        words.add("KOAN");
        words.add("PARALLEL STRUCTURE");
        words.add("PARATACTIC SENTENCE");
        words.add("PARODY");
        words.add("PERIODIC");
        words.add("PERSONIFICATION");
        words.add("PLOT");
        words.add("RISING ACTION");
        words.add("CLIMAX");
        words.add("RESOLUTION");
        words.add("POINT OF VIEW");
        words.add("FIRST PERSON POINT OF VIEW");
        words.add("THIRD PERSON POINT OF VIEW");
        words.add("OMNISCIENT POINT OF VIEW");
        words.add("OBJECTIVE POINT OF VIEW");
        words.add("POLYSYNDETON");
        words.add("PROTAGONIST");
        words.add("PUN");
        words.add("QUATRAIN");
        words.add("REFRAIN");
        words.add("RHYTHM");
        words.add("RHETORIC");
        words.add("RHETORICAL QUESTION");
        words.add("ROMANCE");
        words.add("SATIRE");
        words.add("SIMILE");
        words.add("SOLILOQUY");
        words.add("STEREOTYPE");
        words.add("STREAM OF CONSCIOUSNESS");
        words.add("STYLE");
        words.add("SUSPENSE");
        words.add("SYMBOL");
        words.add("SYNECDOCHE");
        words.add("SYNTACTIC FLUENCY");
        words.add("SYNTACTIC PERMUTATION");
        words.add("TALL TALE");
        words.add("TELEGRAPHIC SENTENCE");
        words.add("THEME");
        words.add("TONE");
        words.add("TRAGEDY");
        words.add("TRICOLON");
        words.add("UNDERSTATEMENT");
        words.add("UNITY");
        words.add("VERNACULAR");
        words.add("IMPRESSIONISM");
        words.add("MODERNISM");
        words.add("NATURALISM");
        words.add("PLAIN STYLE");
        words.add("PURITANISM");
        words.add("RATIONALISM");
        words.add("REALISM");
        words.add("REGIONALISM");
        words.add("ROMANTICISM");
        words.add("SURREALISM");
        words.add("SYMBOLISM");
        words.add("TRANSCENDENTALISM");
        words.add("TIME LINE");
//Defs
        DEFS.add("ALLEGORY - story or poem in which characters, settings, and events stand for other people or events or for abstract ideas or qualities. EXAMPLE: Animal Farm; Dante's Inferno; Lord of the Flies.");
        DEFS.add("ALLITERATION - repetition of the same or similar consonant sounds in words that are close together. EXAMPLE: “When the two youths turned with the flag they saw that much of the regiment had crumbled away, and the dejected remnant was coming slowly back.” –Stephen Crane (Note how regiment and remnant are being used; the regiment is gone, a remnant remains...).");
        DEFS.add("ALLUSION - reference to someone or something that is known from history, literature, religion, politics, sports, science, or another branch of culture. An indirect reference to something (usually from literature, etc.).");
        DEFS.add("AMBIGUITY - deliberately suggesting two or more different, and sometimes conflicting, meanings in a work. An event or situation that may be interpreted in more than one way - this is done on purpose by the author, when it is not done on purpose, it is vagueness, and detracts from the work.");
        DEFS.add("ANALOGY - Comparison made between two things to show how they are alike.");
        DEFS.add("ANAPHORA - Repetition of a word, phrase, or clause at the beginning of two or more sentences in a row. This is a deliberate form of repetition and helps make the writer's point more coherent.");
        DEFS.add("ANASTROPHE - Inversion of the usual, normal, or logical order of the parts of a sentence. Purpose is rhythm or emphasis or euphony. It is a fancy word for inversion.");
        DEFS.add("ANECDOTE - Brief story, told to illustrate a point or serve as an example of something, often shows character of an individual.");
        DEFS.add("ANTAGONIST - Opponent who struggles against or blocks the hero, or protagonist, in a story.");
        DEFS.add("ANTIMETABOLE - Repetition of words in successive clauses in reverse grammatical order. Moliere: “One should eat to live, not live to eat.” In poetry, this is called chiasmus.");
        DEFS.add("ANTITHESIS - Balancing words, phrases, or ideas that are strongly contrasted, often by means of grammatical structure.");
        DEFS.add("ANTIHERO - Central character who lacks all the qualities traditionally associated with heroes. May lack courage, grace, intelligence, or moral scruples.");
        DEFS.add("ANTHROPOMORPHISM - Attributing human characteristics to an animal or inanimate object (Personification).");
        DEFS.add("APHORISM - Brief, cleverly worded statement that makes a wise observation about life, or of a principle or accepted general truth. Also called maxim, epigram.");
        DEFS.add("APOSTROPHE - Calling out to an imaginary, dead, or absent person, or to a place or thing, or a personified abstract idea. If the character is asking a god or goddess for inspiration it is called an invocation. Josiah Holland: “Loacöon! Thou great embodiment/ Of human life and human history!”");
        DEFS.add("APPOSITION - Placing in immediately succeeding order of two or more coordinate elements, the latter of which is an explanation, qualification, or modification of the first (often set off by a colon). Paine: “These are the times that try men's souls: The summer soldier and the sunshine patriot will in this crisis, shrink from the service of his country; but he that stands it Now, deserves the love and thanks of man and woman.”");
        DEFS.add("ASSONANCE - The repetition of similar vowel sounds followed by different consonant sounds especially in words that are together.");
        DEFS.add("ASYNDETON - Commas used without conjunction to separate a series of words, thus emphasizing the parts equally: instead of X, Y, and Z... the writer uses X, Y, Z.... See polysyndeton.");
        DEFS.add("BALANCE - Constructing a sentence so that both halves are about the same length and importance. Sentences can be unbalanced to serve a special effect as well.");
        DEFS.add("CHARACTERIZATION - The process by which the writer reveals the personality of a character.");
        DEFS.add("INDIRECT CHARACTERIZATION - The author reveals to the reader what the character is like by describing how the character looks and dresses, by letting the reader hear what the character says, by revealing the character's private thoughts and feelings, by revealing the character's effect on other people (showing how other characters feel or behave toward the character), or by showing the character in action. Common in modern literature.");
        DEFS.add("DIRECT CHARACTERIZATION - The author tells us directly what the character is like: sneaky, generous, mean to pets and so on. Romantic style literature relied more heavily on this form.");
        DEFS.add("STATIC CHARACTER - Is one who does not change much in the course of a story.");
        DEFS.add("DYNAMIC CHARACTER - Is one who changes in some important way as a result of the story's action.");
        DEFS.add("FLAT CHARACTER - Has only one or two personality traits. They are one dimensional, like a piece of cardboard. They can be summed up in one phrase.");
        DEFS.add("ROUND CHARACTER - Has more dimensions to their personalities - they are complex, just as real people are.");
        DEFS.add("CHIASMUS - In poetry, a type of rhetorical balance in which the second part is syntactically balanced against the first, but with the parts reversed. Coleridge: “Flowers are lovely, love is flowerlike.” In prose this is called antimetabole.");
        DEFS.add("CLICHE - Is a word or phrase, often a figure of speech, that has become lifeless because of overuse. Avoid clichés like the plague. (That cliché is intended.)");
        DEFS.add("COLLOQUIALISM - A word or phrase in everyday use in conversation and informal writing but is inappropriate for formal situations. Example: “He's out of his head if he thinks I'm gonna go for such a stupid idea.”");
        DEFS.add("COMEDY - In general, a story that ends with a happy resolution of the conflicts faced by the main character or characters.");
        DEFS.add("CONCEIT - An elaborate metaphor that compares two things that are startlingly different. Often an extended metaphor.");
        DEFS.add("CONFESSIONAL POETRY - A twentieth century term used to describe poetry that uses intimate material from the poet's life.");
        DEFS.add("CONFLICT - The struggle between opposing forces or characters in a story.");
        DEFS.add("EXTERNAL CONFLICT - Conflicts can exist between two people, between a person and nature or a machine, or between a person and a whole society.");
        DEFS.add("INTERNAL CONFLICT - A conflict can be internal, involving opposing forces within a person's mind.");
        DEFS.add("CONNOTATION - The associations and emotional overtones that have become attached to a word or phrase, in addition to its strict dictionary definition.");
        DEFS.add("COUPLET - Two consecutive rhyming lines of poetry.");
        DEFS.add("DIALECT - A way of speaking that is characteristic of a certain social group or of the inhabitants of a certain geographical area.");
        DEFS.add("DICTION - A speaker or writer's choice of words.");
        DEFS.add("DIDACTIC - Form of fiction or nonfiction that teaches a specific lesson or moral or provides a model of correct behavior or thinking.");
        DEFS.add("ELEGY - A poem of mourning, usually about someone who has died. A Eulogy is great praise or commendation, a laudatory speech, often about someone who has died.");
        DEFS.add("EPANALEPSIS - Device of repetition in which the same expression (single word or phrase) is repeated both at the beginning and at the end of the line, clause, or sentence. Voltaire: “Common sense is not so common.”");
        DEFS.add("EPIC - A long narrative poem, written in heightened language, which recounts the deeds of a heroic character who embodies the values of a particular society.");
        DEFS.add("EPIGRAPH - A quotation or aphorism at the beginning of a literary work suggestive of the theme.");
        DEFS.add("EPISTROPHE - Device of repetition in which the same expression (single word or phrase) is repeated at the end of two or more lines, clauses, or sentences (it is the opposite of anaphora).");
        DEFS.add("EPITHET - An adjective or adjective phrase applied to a person or thing that is frequently used to emphasize a characteristic quality. “Father of our country” and “the great Emancipator” are examples. A Homeric epithet is a compound adjective used with a person or thing: “swift-footed Achilles”; “rosy-fingered dawn.”");
        DEFS.add("ESSAY - A short piece of nonfiction prose in which the writer discusses some aspect of a subject.");
        DEFS.add("ARGUMENTATION - One of the four forms of discourse which uses logic, ethics, and emotional appeals (logos, ethos, pathos) to develop an effective means to convince the reader to think or act in a certain way.");
        DEFS.add("PERSUASION - Relies more on emotional appeals than on facts.");
        DEFS.add("ARGUMENT - Form of persuasion that appeals to reason instead of emotion to convince an audience to think or act in a certain way.");
        DEFS.add("CAUSAL RELATIONSHIP - Form of argumentation in which the writer claims that one thing results from another, often used as part of a logical argument.");
        DEFS.add("DESCRIPTION - A form of discourse that uses language to create a mood or emotion.");
        DEFS.add("EXPOSITION - One of the four major forms of discourse, in which something is explained or “set forth.”");
        DEFS.add("NARRATIVE - The form of discourse that tells about a series of events.");
        DEFS.add("EXPLICATION - Act of interpreting or discovering the meaning of a text, usually involves close reading and special attention to figurative language.");
        DEFS.add("FABLE - A very short story told in prose or poetry that teaches a practical lesson about how to succeed in life.");
        DEFS.add("FARCE - A type of comedy in which ridiculous and often stereotyped characters are involved in silly, far-fetched situations.");
        DEFS.add("FIGURATIVE LANGUAGE - Words which are inaccurate if interpreted literally, but are used to describe. Similes and metaphors are common forms.");
        DEFS.add("FLASHBACK - A scene that interrupts the normal chronological sequence of events in a story to depict something that happened at an earlier time.");
        DEFS.add("FOIL - A character who acts as contrast to another character. Often a funny sidekick to the dashing hero, or a villain contrasting the hero.");
        DEFS.add("FORESHADOWING - The use of hints and clues to suggest what will happen later in a plot.");
        DEFS.add("FREE VERSE - Poetry that does not conform to a regular meter or rhyme scheme.");
        DEFS.add("HYPERBOLE - A figure of speech that uses an incredible exaggeration or overstatement, for effect. “If I told you once, I've told you a million times....”");
        DEFS.add("HYPOTACTIC - Sentence marked by the use of connecting words between clauses or sentences, explicitly showing the logical or other relationships between them. (Use of such syntactic subordination of just one clause to another is known as hypotaxis). I am tired because it is hot.");
        DEFS.add("IMAGERY - The use of language to evoke a picture or a concrete sensation of a person, a thing, a place, or an experience.");
        DEFS.add("INVERSION - The reversal of the normal word order in a sentence or phrase.");
        DEFS.add("IRONY - A discrepancy between appearances and reality.");
        DEFS.add("VERBAL IRONY - Occurs when someone says one thing but really means something else.");
        DEFS.add("SITUATIONAL IRONY - Takes place when there is a discrepancy between what is expected to happen, or what would be appropriate to happen, and what really does happen.");
        DEFS.add("DRAMATIC IRONY - Is so called because it is often used on stage. A character in the play or story thinks one thing is true, but the audience or reader knows better.");
        DEFS.add("JUXTAPOSITION - Poetic and rhetorical device in which normally unassociated ideas, words, or phrases are placed next to one another, creating an effect of surprise and wit. Ezra Pound: “The apparition of these faces in the crowd;/ Petals on a wet, black bough.” Juxtaposition is also a form of contrast by which writers call attention to dissimilar ideas or images or metaphors.");
        DEFS.add("LITOTES - Is a form of understatement in which the positive form is emphasized through the negation of a negative form: Hawthorne - “...the wearers of petticoat and farthingale...stepping forth into the public ways, and wedging their not unsubstantial persons, if occasion were, into the throng...”");
        DEFS.add("LOCAL COLOR - A term applied to fiction or poetry which tends to place special emphasis on a particular setting, including its customs, clothing, dialect and landscape.");
        DEFS.add("LOOSE SENTENCE - One in which the main clause comes first, followed by further dependent grammatical units. See periodic sentence. Hawthorne: “Hester gazed after him a little while, looking with a half-fantastic curiosity to see whether the tender grass of early spring would not be blighted beneath him, and show the wavering track of his footsteps, sere and brown, across its cheerful verdure.”");        DEFS.add("LYRIC POEM - A poem that does not tell a story but expresses the personal feelings or thoughts of the speaker. A ballad tells a story.");
        DEFS.add("METAPHOR - A figure of speech that makes a comparison between two unlike things without the use of such specific words of comparison as like, as, than, or resembles.");
        DEFS.add("IMPLIED METAPHOR - Does not state explicitly the two terms of the comparison: “I like to see it lap the miles” is an implied metaphor in which the verb lap implies a comparison between “it” and some animal that “laps” up water.");
        DEFS.add("EXTENDED METAPHOR - Is a metaphor that is extended or developed as far as the writer wants to take it. (Conceit if it is quite elaborate).");
        DEFS.add("DEAD METAPHOR - Is a metaphor that has been used so often that the comparison is no longer vivid: “The head of the house”, “the seat of the government”, “a knotty problem” are all dead metaphors.");
        DEFS.add("MIXED METAPHOR - Is a metaphor that has gotten out of control and mixes its terms so that they are visually or imaginatively incompatible. “The President is a lame duck who is running out of gas.”");
        DEFS.add("METONYMY - A figure of speech in which a person, place, or thing, is referred to by something closely associated with it. “We requested from the crown support for our petition.” The crown is used to represent the monarch.");
        DEFS.add("MOOD - An atmosphere created by a writer's diction and the details selected.");
        DEFS.add("MOTIF - A recurring image, word, phrase, action, idea, object, or situation used throughout a work (or in several works by one author), unifying the work by tying the current situation to previous ones, or new ideas to the theme. Kurt Vonnegut uses “So it goes” throughout Slaughterhouse-Five to remind the reader of the senselessness of death.");
        DEFS.add("MOTIVATION - The reasons for a character's behavior.");
        DEFS.add("ONOMATOPOEIA - The use of words whose sounds echo their sense. “Pop.” “Zap.”");
        DEFS.add("OXYMORON - A figure of speech that combines opposite or contradictory terms in a brief phrase. “Jumbo shrimp.” “Pretty ugly.” “Bitter-sweet.”");
        DEFS.add("PARABLE - A relatively short story that teaches a moral, or lesson about how to lead a good life.");
        DEFS.add("PARADOX - A statement that appears self-contradictory, but that reveals a kind of truth.");
        DEFS.add("KOAN - Is a paradox used in Zen Buddhism to gain intuitive knowledge: “What is the sound of one hand clapping?”");
        DEFS.add("PARALLEL STRUCTURE - (Parallelism) the repetition of words or phrases that have similar grammatical structures.");
        DEFS.add("PARATACTIC SENTENCE - Simply juxtaposes clauses or sentences. I am tired: it is hot.");
        DEFS.add("PARODY - A work that makes fun of another work by imitating some aspect of the writer's style.");
        DEFS.add("PERIODIC - Sentence that places the main idea or central complete thought at the end of the sentence, after all introductory elements.");
        DEFS.add("PERSONIFICATION - A figure of speech in which an object or animal is given human feelings, thoughts, or attitudes.");
        DEFS.add("PLOT - The series of related events in a story or play, sometimes called the storyline.");
        DEFS.add("EXPOSITION - Introduces characters, situation, and setting.");
        DEFS.add("RISING ACTION - Complications in conflict and situations (may introduce new ones as well).");
        DEFS.add("CLIMAX - That point in a plot that creates the greatest intensity, suspense, or interest. Also called “turning point.”");
        DEFS.add("RESOLUTION - The conclusion of a story, when all or most of the conflicts have been settled; often called the denouement.");
        DEFS.add("POINT OF VIEW - The vantage point from which the writer tells the story.");
        DEFS.add("FIRST PERSON POINT OF VIEW - One of the characters tells the story.");
        DEFS.add("THIRD PERSON POINT OF VIEW - An unknown narrator tells the story, but this narrator zooms in to focus on the thoughts and feelings of only one character.");
        DEFS.add("OMNISCIENT POINT OF VIEW - An omniscient or all-knowing narrator tells the story, also using the third-person pronouns. This narrator, instead of focusing on one character only, often tells us everything about many characters.");
        DEFS.add("OBJECTIVE POINT OF VIEW - A narrator who is totally impersonal and objective tells the story, with no comment on any characters or events.");
        DEFS.add("POLYSYNDETON - Sentence which uses a conjunction with NO commas to separate the items in a series. Instead of X, Y, and Z... Polysyndeton results in X and Y and Z... Kurt Vonnegut uses this device.");
        DEFS.add("PROTAGONIST - The central character in a story, the one who initiates or drives the action. Usually the hero or anti-hero; in a tragic hero, like John Proctor of The Crucible, there is always a hamartia, or tragic flaw in his character which will lead to his downfall.");
        DEFS.add("PUN - A “play on words” based on the multiple meanings of a single word or on words that sound alike but mean different things.");
        DEFS.add("QUATRAIN - A poem consisting of four lines, or four lines of a poem that can be considered as a unit.");
        DEFS.add("REFRAIN - A word, phrase, line, or group of lines that is repeated, for effect, several times in a poem.");
        DEFS.add("RHYTHM - A rise and fall of the voice produced by the alternation of stressed and unstressed syllables in language.");
        DEFS.add("RHETORIC - Art of effective communication, especially persuasive discourse.");
        DEFS.add("RHETORICAL QUESTION - A question asked for an effect, and not actually requiring an answer.");
        DEFS.add("ROMANCE - In general, a story in which an idealized hero or heroine undertakes a quest and is successful.");
        DEFS.add("SATIRE - A type of writing that ridicules the shortcomings of people or institutions in an attempt to bring about a change.");
        DEFS.add("SIMILE - A figure of speech that makes an explicit comparison between two unlike things, using words such as like, as, than, or resembles.");
        DEFS.add("SOLILOQUY - A long speech made by a character in a play while no other characters are on stage.");
        DEFS.add("STEREOTYPE - A fixed idea or conception of a character or an idea which does not allow for any individuality, often based on religious, social, or racial prejudices.");
        DEFS.add("STREAM OF CONSCIOUSNESS - A style of writing that portrays the inner (often chaotic) workings of a character's mind.");
        DEFS.add("STYLE - The distinctive way in which a writer uses language: a writer's distinctive use of diction, tone, and syntax.");
        DEFS.add("SUSPENSE - A feeling of uncertainty and curiosity about what will happen next in a story.");
        DEFS.add("SYMBOL - A person, place, thing, or event that has meaning in itself and that also stands for something more than itself.");
        DEFS.add("SYNECDOCHE - A figure of speech in which a part represents the whole. “If you don't drive properly, you will lose your wheels.” The wheels represent the entire car.");
        DEFS.add("SYNTACTIC FLUENCY - Ability to create a variety of sentence structures, appropriately complex and/or simple and varied in length.");
        DEFS.add("SYNTACTIC PERMUTATION - Sentence structures that are extraordinarily complex and involved. Often difficult for a reader to follow.");
        DEFS.add("TALL TALE - An outrageously exaggerated, humorous story that is obviously unbelievable.");
        DEFS.add("TELEGRAPHIC SENTENCE - A sentence shorter than five words in length.");
        DEFS.add("THEME - The insight about human life that is revealed in a literary work.");
        DEFS.add("TONE - The attitude a writer takes toward the subject of a work, the characters in it, or the audience, revealed through diction, figurative language, and organization.");
        DEFS.add("TRAGEDY - In general, a story in which a heroic character either dies or comes to some other unhappy end.");
        DEFS.add("TRICOLON - Sentence of three parts of equal importance and length, usually three independent clauses.");
        DEFS.add("UNDERSTATEMENT - A statement that says less than what is meant.");
        DEFS.add("UNITY - Unified parts of the writing are related to one central idea or organizing principle. Unity is dependent upon coherence.");
        DEFS.add("VERNACULAR - The language spoken by the people who live in a particular locality.");
        DEFS.add("IMPRESSIONISM - A nineteenth-century movement in literature and art which advocated a recording of the artist's personal impressions of the world, rather than a strict representation of reality.");
        DEFS.add("MODERNISM - A term for the bold new experimental styles and forms that swept the arts during the first third of the twentieth century.");
        DEFS.add("NATURALISM - A nineteenth-century literary movement that was an extension of realism and that claimed to portray life exactly as it was.");
        DEFS.add("PLAIN STYLE - Writing style that stresses simplicity and clarity of expression (but will still utilize allusions and metaphors), and was the main form of the Puritan writers.");
        DEFS.add("PURITANISM - Writing style of America's early English-speaking colonists. Emphasizes obedience to God and consists mainly of journals, sermons, and poems.");
        DEFS.add("RATIONALISM - A movement that began in Europe in the seventeenth century, which held that we can arrive at truth by using our reason rather than relying on the authority of the past, on the authority of the Church, or an institution. ALSO CALLED NEOCLASSICISM AND AGE OF REASON.");
        DEFS.add("REALISM - A style of writing, developed in the nineteenth century, that attempts to depict life accurately without idealizing or romanticizing it.");
        DEFS.add("REGIONALISM - Literature that emphasizes a specific geographic setting and that reproduces the speech, behavior, and attitudes of the people who live in that region.");
        DEFS.add("ROMANTICISM - A revolt against Rationalism that affected literature and the other arts, beginning in the late eighteenth century and remaining strong throughout most of the nineteenth century.");
        DEFS.add("SURREALISM - A movement in art and literature that started in Europe during the 1920s. Surrealists wanted to replace conventional realism with the full expression of the unconscious mind, which they considered to be more real than the “real” world of appearances.");
        DEFS.add("SYMBOLISM - A literary movement that originated in late nineteenth-century France, in which writers rearranged the world of appearances in order to reveal a more truthful version of reality.");
        DEFS.add("TRANSCENDENTALISM - A nineteenth-century movement in the Romantic tradition, which held that every individual can reach ultimate truths through spiritual intuition, which transcends reason and sensory experience.");
        DEFS.add("TIME LINE - Puritanism 1620 - 1770s; Neoclassic 1770s - early 1800s; Romanticism early 1800s - 1870s; Realism 1850s - early 1900s; Regionalism 1884 - early 1900s; Naturalism late 1800s - mid 1900s; Modernism 1920s - 1945; Post-Modernism 1945 - present.");
  }
}
