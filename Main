import java.util.List;

public class Main {
    public static void main(String[] args) {

        List<String> words = new ArrayList<>();
        List<String> DEFS = new ArrayList<>();

        words.add("ALLEGORY");
        words.add("ALLITERATION");
        words.add("ALLUSION");
        words.add("AMBIGUITY");
        words.add("ANALOGY");
        words.add("ANAPHORA");
        words.add("ANASTROPHE");
        words.add("ANECDOTE");
        words.add("ANTAGONIST");
